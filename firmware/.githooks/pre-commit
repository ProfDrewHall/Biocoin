#!/bin/sh
set -eu

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
FIRMWARE_DIR=$(CDPATH= cd -- "$HOOK_DIR/.." && pwd)
cd "$FIRMWARE_DIR"

echo "pre-commit: running sanity checks..."
sh "scripts/sanity_checks.sh"

echo "pre-commit: running sensor mode smoke checks..."
sh "scripts/smoke_sensor_modes.sh"

echo "pre-commit: building debug and release firmware..."
sh "scripts/build_firmware_artifacts.sh"

echo "pre-commit: staging firmware build artifacts..."
git add -- "builds"

echo "pre-commit: checks and artifact staging complete."
